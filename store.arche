/// The tasks in a file, as JSON. A save writes a new file under a name of its
/// own, syncs it, renames it into place and syncs the directory: neither a
/// crash nor a power cut leaves half a file, and two runs at once do not write
/// into one file.
import alloc;
import board;
import date;
import std;
import std.json;
import std.path;
import std.testing as std_testing;

pub type StoreError = error { CannotRead, CannotWrite, BadFormat, DuplicateId }

pub fn explain(e: StoreError) -> str {
    match e {
        .CannotRead => { return "vazifalar faylini o'qib bo'lmadi"; }
        .CannotWrite => { return "vazifalar faylini yozib bo'lmadi"; }
        .BadFormat => { return "vazifalar fayli buzilgan"; }
        .DuplicateId => { return "vazifalar faylida bir raqam ikki vazifada turibdi"; }
    }
}

// ---- writing ------------------------------------------------------------------------

fn push_date_field(out: &mut alloc.String, key: str, d: date.Date) {
    out.push_str(", \"");
    out.push_str(key);
    out.push_str("\": \"");
    date.write(d, out:);
    out.push_str("\"");
}

fn push_task(out: &mut alloc.String, t: &board.Task) {
    out.push_str("    {\"id\": ");
    out.push_u64(t.id as u64);
    out.push_str(", \"title\": ");
    json.write_string(t.title.view(), out:);
    out.push_str(", \"priority\": \"");
    out.push_str(t.priority.name());
    out.push_str("\", \"tags\": [");
    var i: usize = 0;
    for tag in t.tags.items() {
        if i > 0 {
            out.push_str(", ");
        }
        json.write_string(tag.view(), out:);
        i += 1;
    }
    out.push_str("]");
    push_date_field(out, key: "created", t.created);
    match t.due {
        some(d) => { push_date_field(out, key: "due", d); }
        none => { }
    }
    match t.status {
        .Done { on } => { push_date_field(out, key: "done", on); }
        _ => { }
    }
    out.push_str("}");
}

/// The board as text. A removed task is left out: its id is not reused, because
/// next_id is kept.
pub fn encode(b: &board.Board, a: alloc.Allocator) -> alloc.String {
    var out = alloc.String.from("{\n  \"next_id\": ", a);
    out.push_u64(b.next_id as u64);
    out.push_str(",\n  \"tasks\": [\n");
    var first = true;
    for t in b.tasks.items() {
        if t.is_removed() {
            continue;
        }
        if not first {
            out.push_str(",\n");
        }
        first = false;
        push_task(&mut out, t);
    }
    out.push_str("\n  ]\n}\n");
    return out;
}

const HEX: str = "0123456789abcdef";

/// A name beside the file for the new one, by chance, so that two runs at once
/// write two files.
fn temporary_name(file: str, rand: &mut std.Rand, a: alloc.Allocator) -> alloc.String {
    var name = alloc.String.from(file, a);
    name.push_ascii('.');
    let r = rand.next_u64();
    var shift: u64 = 64;
    while shift > 0 {
        shift -= 4;
        name.push_ascii(HEX.bytes()[((r >> shift) & 15) as usize]);
    }
    name.push_str(".tmp");
    return name;
}

pub fn save(fs: &std.Fs, rand: &mut std.Rand, file: str, b: &board.Board, a: alloc.Allocator) -> StoreError!void {
    let text = encode(b, a);
    let temporary = temporary_name(file, rand:, a:);
    fs.write_file(path: temporary.view(), data: text.view()) catch return StoreError.CannotWrite;
    fs.sync(temporary.view()) catch return StoreError.CannotWrite;
    match fs.rename(from: temporary.view(), to: file) {
        ok(_) => { }
        err(_) => {
            _ = fs.remove(temporary.view());
            return StoreError.CannotWrite;
        }
    }
    var dir = path.parent(file);
    if dir.len() == 0 {
        dir = ".";
    }
    fs.sync(dir) catch return StoreError.CannotWrite;
}

// ---- reading ------------------------------------------------------------------------

/// The member of an object at the place key_index said.
fn member(v: &json.Value, place: usize) -> &json.Value {
    match v {
        .Object { values, .. } => { return &values.items()[place]; }
        _ => { panic("key_index found a key in what is no object"); }
    }
}

/// The member named key, which the object must have.
fn field(v: &json.Value, key: str) -> StoreError!usize {
    return json.key_index(v, key) orelse return StoreError.BadFormat;
}

fn copy_of_text(v: &json.Value, a: alloc.Allocator) -> StoreError!alloc.String {
    return match v {
        .Text { value } => { alloc.String.from(value.view(), a) }
        _ => { return StoreError.BadFormat; }
    };
}

fn date_of(v: &json.Value) -> StoreError!date.Date {
    return match v {
        .Text { value } => { date.parse(value.view()) orelse return StoreError.BadFormat }
        _ => { return StoreError.BadFormat; }
    };
}

fn u32_of(v: &json.Value) -> StoreError!u32 {
    let n = json.as_i64(v) orelse return StoreError.BadFormat;
    if n < 0 or n > 4294967295 {
        return StoreError.BadFormat;
    }
    return n as u32;
}

fn read_task(v: &json.Value, a: alloc.Allocator) -> StoreError!board.Task {
    let id = try u32_of(member(v, place: try field(v, key: "id")));
    let title = try copy_of_text(member(v, place: try field(v, key: "title")), a);
    let priority_name = try copy_of_text(member(v, place: try field(v, key: "priority")), a);
    let priority = board.Priority.parse(priority_name.view()) orelse return StoreError.BadFormat;
    var tags = alloc.List(alloc.String).init(a);
    match member(v, place: try field(v, key: "tags")) {
        .Array { items } => {
            for item in items.items() {
                tags.push(try copy_of_text(item, a));
            }
        }
        _ => { return StoreError.BadFormat; }
    }
    let created = try date_of(member(v, place: try field(v, key: "created")));
    var due: ?date.Date = none;
    match json.key_index(v, "due") {
        some(i) => { due = some(try date_of(member(v, place: i))); }
        none => { }
    }
    var status = board.Status.Open;
    match json.key_index(v, "done") {
        some(i) => { status = board.Status.Done { on: try date_of(member(v, place: i)) }; }
        none => { }
    }
    return board.Task { id: id, title: title, tags: tags, priority: priority, created: created, due: due, status: status };
}

/// The board in this text.
pub fn decode(text: str, a: alloc.Allocator) -> StoreError!board.Board {
    let parsed = json.parse(text, a) catch return StoreError.BadFormat;
    var b = board.Board.init(a);
    match member(&parsed, place: try field(&parsed, key: "tasks")) {
        .Array { items } => {
            for item in items.items() {
                b.restore(try read_task(item, a)) catch return StoreError.DuplicateId;
            }
        }
        _ => { return StoreError.BadFormat; }
    }
    let next = try u32_of(member(&parsed, place: try field(&parsed, key: "next_id")));
    if next > b.next_id {
        b.next_id = next;
    }
    return b;
}

/// The board in the file; an empty one if there is no such file yet.
pub fn load(fs: &std.Fs, file: str, a: alloc.Allocator) -> StoreError!board.Board {
    if not fs.exists(file) {
        return board.Board.init(a);
    }
    let text = fs.read_file(file, a) catch return StoreError.CannotRead;
    return try decode(text.view(), a);
}

fn day(n: u8) -> date.Date {
    return date.make(2026, month: 11, day: n) orelse panic("a date");
}

test "what is saved reads back the same" (t: &mut std_testing.Test) {
    let a = t.system().alloc;
    var b = board.Board.init(a);
    var tags = alloc.List(alloc.String).init(a);
    tags.push(alloc.String.from("ish", a));
    tags.push(alloc.String.from("\"muhim\" yangi\nqator", a));
    let first = b.add("Hisobot: \"oy yakuni\"", tags, board.Priority.High, due: some(day(20)), created: day(1));
    let second = b.add("Ikkinchi", alloc.List(alloc.String).init(a), board.Priority.Low, due: none, created: day(2));
    let third = b.add("O'chiriladi", alloc.List(alloc.String).init(a), board.Priority.Normal, due: none, created: day(2));
    b.finish(second, on: day(3)) catch panic("unexpected error");
    b.remove(third) catch panic("unexpected error");

    let text = encode(&b, a);
    let back = decode(text.view(), a) catch panic("unexpected error");
    assert(back.tasks.len() == 2);
    assert(back.next_id == 4);
    assert(back.tasks[0].id == first);
    assert(back.tasks[0].title.view().eq("Hisobot: \"oy yakuni\""));
    assert(back.tasks[0].tags.len() == 2);
    assert(back.tasks[0].tags[1].view().eq("\"muhim\" yangi\nqator"));
    assert(back.tasks[0].is_open());
    assert(not back.tasks[1].is_open());
    // Written again, it is the same bytes.
    let again = encode(&back, a);
    assert(again.view().eq(text.view()));
}

test "a broken file is said to be so" (t: &mut std_testing.Test) {
    let a = t.system().alloc;
    match decode("{\"tasks\": [", a) {
        err(.BadFormat) => { }
        _ => { panic("bad text was read"); }
    }
    match decode("{\"next_id\": 1, \"tasks\": [{\"id\": 1}]}", a) {
        err(.BadFormat) => { }
        _ => { panic("a task with no title was read"); }
    }
    match decode("[1, 2]", a) {
        err(.BadFormat) => { }
        _ => { panic("a list was read"); }
    }
}

test "two tasks with one id are refused" (t: &mut std_testing.Test) {
    let a = t.system().alloc;
    var text = alloc.String.from("{\"next_id\": 3, \"tasks\": [", a);
    text.push_str("{\"id\": 1, \"title\": \"a\", \"priority\": \"past\", \"tags\": [], \"created\": \"2026-11-06\"}, ");
    text.push_str("{\"id\": 1, \"title\": \"b\", \"priority\": \"yuqori\", \"tags\": [], \"created\": \"2026-11-06\"}]}");
    match decode(text.view(), a) {
        err(.DuplicateId) => { }
        _ => { panic("the same id was read twice"); }
    }
}

test "a save names its file by chance, beside the file" (t: &mut std_testing.Test) {
    let sys = t.system();
    let one = temporary_name("data/v.json", rand: &mut sys.rand, a: sys.alloc);
    let two = temporary_name("data/v.json", rand: &mut sys.rand, a: sys.alloc);
    assert(one.view().starts_with("data/v.json."));
    assert(one.len() == "data/v.json.".len() + 16 + 4);
    assert(not one.view().eq(two.view()));
}
